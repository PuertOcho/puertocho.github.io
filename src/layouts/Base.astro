---
import '../styles/global.css';
import { content, social, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altHref = altLang === 'es' ? '/' : '/en/';
const homeHref = lang === 'es' ? '/' : '/en/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href={homeHref} class="brand">
          <span class="brand-mark">AP</span>
          <span class="brand-name">Antonio Puerto</span>
        </a>
        <nav class="nav-links">
          <a href="#about">{t.nav.about}</a>
          <a href="#services">{t.nav.services}</a>
          <a href="#projects">{t.nav.projects}</a>
          <a href="#contact">{t.nav.contact}</a>
        </nav>
        <div class="nav-actions">
          <a class="lang-switch" href={altHref} aria-label="Change language">{altLang.toUpperCase()}</a>
          <a class="btn btn-ghost btn-sm" href="#contact">{t.hero.ctaPrimary}</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <strong>Antonio Puerto</strong>
          <p>{t.footer.tagline}</p>
        </div>
        <div class="footer-links">
          <a href={social.github} target="_blank" rel="noopener">GitHub</a>
          <a href={social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${t.contact.email}`}>Email</a>
        </div>
        <p class="footer-rights">© 2026 Antonio Puerto · {t.footer.rights}</p>
      </div>
    </footer>

    <script>
      // Revelado al hacer scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>

    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        background: rgba(11, 11, 18, 0.7);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
      .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; }
      .brand-mark {
        display: grid; place-items: center;
        width: 34px; height: 34px; border-radius: 9px;
        background: var(--grad); color: #0b0b12; font-weight: 700; font-size: 0.85rem;
      }
      .nav-links { display: flex; gap: 26px; font-size: 0.95rem; }
      .nav-links a { color: var(--text-muted); transition: color 0.15s; }
      .nav-links a:hover { color: var(--text); }
      .nav-actions { display: flex; align-items: center; gap: 14px; }
      .lang-switch {
        font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);
        border: 1px solid var(--border); border-radius: 8px; padding: 5px 9px; transition: all 0.15s;
      }
      .lang-switch:hover { color: var(--cyan); border-color: var(--cyan); }
      .btn-sm { padding: 8px 16px; font-size: 0.9rem; }

      .footer { border-top: 1px solid var(--border); padding-block: 48px; margin-top: 40px; }
      .footer-inner { display: grid; gap: 22px; }
      .footer p { color: var(--text-muted); font-size: 0.95rem; }
      .footer-links { display: flex; gap: 22px; }
      .footer-links a { color: var(--text-muted); }
      .footer-links a:hover { color: var(--cyan); }
      .footer-rights { color: var(--text-dim); font-size: 0.85rem; }

      @media (max-width: 720px) {
        .nav-links { display: none; }
        .brand-name { display: none; }
      }
    </style>
  </body>
</html>
