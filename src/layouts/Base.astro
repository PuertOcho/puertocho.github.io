---
import '../styles/global.css';
import { content, social, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altHref = altLang === 'es' ? '/' : '/en/';
const homeHref = lang === 'es' ? '/' : '/en/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f6f4ef" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href={homeHref} class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">antonio puerto</span>
        </a>
        <nav class="nav-links">
          <a href="#about">{t.nav.about.toLowerCase()}</a>
          <a href="#services">{t.nav.services.toLowerCase()}</a>
          <a href="#projects">{t.nav.projects.toLowerCase()}</a>
          <a href="#contact">{t.nav.contact.toLowerCase()}</a>
          <a href={t.nav.cvHref} target="_blank" rel="noopener">{t.nav.cvLabel.toLowerCase()} ↓</a>
        </nav>
        <div class="nav-actions">
          <a class="lang-switch" href={altHref} aria-label="Change language">{altLang}</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="footer-name">Antonio Puerto</span>
          <span class="footer-tagline">{t.footer.tagline}</span>
        </div>
        <div class="footer-links">
          <a href={social.github} target="_blank" rel="noopener">github</a>
          <a href={social.linkedin} target="_blank" rel="noopener">linkedin</a>
          <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        </div>
        <p class="footer-rights">© 2026 · {t.footer.rights}</p>
      </div>
    </footer>

    <script>
      // Revelado al hacer scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>

    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; }
      .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.92rem; font-weight: 600; letter-spacing: 0.01em; }
      .brand-mark { width: 11px; height: 11px; background: var(--accent); display: inline-block; }
      .nav-links { display: flex; gap: 24px; font-family: var(--font-mono); font-size: 0.84rem; }
      .nav-links a { color: var(--ink-soft); transition: color 0.15s; }
      .nav-links a:hover { color: var(--accent-ink); }
      .nav-actions { display: flex; align-items: center; gap: 12px; }
      .lang-switch {
        font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--ink-soft);
        border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 4px 10px; transition: all 0.15s;
      }
      .lang-switch:hover { color: var(--accent-ink); border-color: var(--accent-ink); }

      .footer { border-top: 1px solid var(--line-strong); padding-block: 40px; background: var(--paper-soft); }
      .footer-inner { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 18px; }
      .footer-brand { display: flex; flex-direction: column; gap: 2px; }
      .footer-name { font-weight: 600; }
      .footer-tagline { color: var(--ink-dim); font-size: 0.88rem; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 20px; font-family: var(--font-mono); font-size: 0.84rem; }
      .footer-links a { color: var(--ink-soft); border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; }
      .footer-links a:hover { color: var(--accent-ink); border-color: var(--accent-ink); }
      .footer-rights { color: var(--ink-dim); font-size: 0.8rem; font-family: var(--font-mono); }

      @media (max-width: 760px) {
        .nav-links { display: none; }
      }
    </style>
  </body>
</html>
