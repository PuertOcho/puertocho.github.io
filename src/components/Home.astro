---
import { content, social, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
---

<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow" data-reveal>{t.hero.kicker}</p>
    <h1 data-reveal>
      {t.hero.titleLead}<br />
      <span class="grad-text">{t.hero.titleAccent}</span>
    </h1>
    <p class="hero-sub" data-reveal>{t.hero.subtitle}</p>
    <div class="hero-cta" data-reveal>
      <a class="btn btn-primary" href="#contact">{t.hero.ctaPrimary} →</a>
      <a class="btn btn-ghost" href="#projects">{t.hero.ctaSecondary}</a>
    </div>
    <div class="hero-stats" data-reveal>
      {t.hero.stats.map((s) => (
        <div class="stat">
          <span class="stat-val grad-text">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===================== ABOUT ===================== -->
<section id="about">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.about.heading}</p>
      <h2>{t.about.lead}</h2>
    </div>
    <div class="about-grid">
      <div class="about-text" data-reveal>
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <aside class="edge-card" data-reveal>
        <span class="edge-icon">⚙️</span>
        <h3>{t.about.edge.title}</h3>
        <p>{t.about.edge.text}</p>
      </aside>
    </div>
  </div>
</section>

<!-- ===================== SERVICES ===================== -->
<section id="services" class="services-section">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.services.heading}</p>
      <h2>{t.services.lead}</h2>
    </div>
    <div class="services-grid">
      {t.services.items.map((s) => (
        <article class="card service" data-reveal>
          <span class="service-icon">{s.icon}</span>
          <h3>{s.title}</h3>
          <p class="service-desc">{s.description}</p>
          <ul>
            {s.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===================== PROJECTS ===================== -->
<section id="projects">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.projects.heading}</p>
      <h2>{t.projects.lead}</h2>
    </div>
    <div class="projects-grid">
      {t.projects.items.map((p) => (
        <a class={`card project${p.featured ? ' is-featured' : ''}`} href={p.href} target="_blank" rel="noopener" data-reveal>
          <div class="project-top">
            <span class="project-name">{p.name}</span>
            <span class="project-arrow">↗</span>
          </div>
          <p class="project-tagline">{p.tagline}</p>
          <p class="project-desc">{p.description}</p>
          <div class="tags">
            {p.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
    <div class="projects-all" data-reveal>
      <a class="btn btn-ghost" href={t.projects.allHref} target="_blank" rel="noopener">{t.projects.allLabel} →</a>
    </div>
  </div>
</section>

<!-- ===================== CONTACT ===================== -->
<section id="contact" class="contact-section">
  <div class="container">
    <div class="contact-card" data-reveal>
      <h2>{t.contact.heading}</h2>
      <p>{t.contact.lead}</p>
      <div class="contact-actions">
        <a class="btn btn-primary" href={`mailto:${t.contact.email}`}>{t.contact.cta} →</a>
        <a class="btn btn-ghost" href={social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
      <p class="contact-email">{t.contact.email}</p>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .hero { padding-block: clamp(80px, 14vw, 150px) clamp(40px, 7vw, 80px); }
  .hero-inner { max-width: 860px; }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 700; }
  .hero-sub { color: var(--text-muted); font-size: clamp(1.05rem, 2.2vw, 1.3rem); margin-top: 24px; max-width: 660px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 56px; border-top: 1px solid var(--border); padding-top: 34px; }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat-val { font-family: var(--font-display); font-size: clamp(1.6rem, 3.5vw, 2.3rem); font-weight: 700; }
  .stat-label { color: var(--text-dim); font-size: 0.85rem; }

  /* ABOUT */
  .about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 36px; align-items: start; }
  .about-text p { color: var(--text-muted); font-size: 1.1rem; margin-bottom: 18px; }
  .edge-card { background: var(--grad-soft); border: 1px solid var(--violet); border-radius: var(--radius); padding: 28px; }
  .edge-icon { font-size: 1.8rem; }
  .edge-card h3 { margin: 12px 0 10px; font-size: 1.3rem; }
  .edge-card p { color: var(--text-muted); }

  /* SERVICES */
  .services-section { background: var(--bg-soft); border-block: 1px solid var(--border); }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .service-icon { font-size: 2rem; }
  .service h3 { margin: 14px 0 10px; font-size: 1.35rem; }
  .service-desc { color: var(--text-muted); margin-bottom: 16px; }
  .service ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .service li { color: var(--text); font-size: 0.95rem; padding-left: 22px; position: relative; }
  .service li::before { content: '→'; position: absolute; left: 0; color: var(--cyan); }

  /* PROJECTS */
  .projects-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .project { display: flex; flex-direction: column; }
  .project.is-featured { border-left: 3px solid var(--violet); }
  .project-top { display: flex; align-items: center; justify-content: space-between; }
  .project-name { font-family: var(--font-mono); font-size: 1.15rem; color: var(--text); font-weight: 500; }
  .project-arrow { color: var(--text-dim); transition: transform 0.2s, color 0.2s; }
  .project:hover .project-arrow { transform: translate(3px, -3px); color: var(--cyan); }
  .project-tagline { color: var(--cyan); font-size: 0.9rem; margin: 6px 0 12px; }
  .project-desc { color: var(--text-muted); font-size: 0.97rem; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .projects-all { margin-top: 34px; text-align: center; }

  /* CONTACT */
  .contact-card { text-align: center; max-width: 720px; margin-inline: auto; background: var(--grad-soft); border: 1px solid var(--border); border-radius: 24px; padding: clamp(36px, 6vw, 64px); }
  .contact-card h2 { font-size: clamp(1.7rem, 4vw, 2.6rem); }
  .contact-card > p { color: var(--text-muted); margin-top: 16px; font-size: 1.1rem; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 30px; }
  .contact-email { font-family: var(--font-mono); color: var(--text-dim); margin-top: 22px; font-size: 0.9rem; }

  @media (max-width: 860px) {
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 26px; }
    .about-grid { grid-template-columns: 1fr; }
    .services-grid { grid-template-columns: 1fr; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
