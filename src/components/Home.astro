---
import { content, social, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="container">
    <p class="hero-kicker" data-reveal>{t.hero.kicker}</p>
    <h1 data-reveal>
      {t.hero.titleLead}<br />
      <span class="accent-mark">{t.hero.titleAccent}</span>
    </h1>
    <p class="hero-sub" data-reveal>{t.hero.subtitle}</p>

    <div class="pipeline" data-reveal aria-hidden="true">
      {t.hero.pipeline.map((step, i) => (
        <>
          {i > 0 && <span class="pipe-arrow">→</span>}
          <span class="pipe-step">{step}</span>
        </>
      ))}
    </div>

    <div class="hero-cta" data-reveal>
      <a class="btn btn-primary" href="#contact">{t.hero.ctaPrimary} →</a>
      <a class="btn btn-ghost" href="#projects">{t.hero.ctaSecondary}</a>
    </div>

    <div class="hero-stats" data-reveal>
      {t.hero.stats.map((s) => (
        <div class="stat">
          <span class="stat-val">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===================== ABOUT ===================== -->
<section id="about">
  <div class="container">
    <div class="sec-label" data-reveal><span class="sec-num">01</span><span>{t.about.heading.toLowerCase()}</span></div>
    <div class="section-head" data-reveal>
      <h2>{t.about.lead}</h2>
    </div>
    <div class="about-grid">
      <div class="about-text" data-reveal>
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <aside class="edge-note" data-reveal>
        <span class="edge-tag">{t.about.edge.title}</span>
        <p>{t.about.edge.text}</p>
      </aside>
    </div>
    <div class="timeline" data-reveal>
      <span class="timeline-heading">{t.about.timelineHeading}</span>
      <ol>
        {t.about.timeline.map((item) => (
          <li>
            <span class="tl-year">{item.year}</span>
            <span class="tl-text">{item.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- ===================== SERVICES ===================== -->
<section id="services" class="services-section">
  <div class="container">
    <div class="sec-label" data-reveal><span class="sec-num">02</span><span>{t.services.heading.toLowerCase()}</span></div>
    <div class="section-head" data-reveal>
      <h2>{t.services.lead}</h2>
    </div>
    <div class="services-grid">
      {t.services.items.map((s) => (
        <article class="service" data-reveal>
          <span class="service-slug">/{s.icon}</span>
          <h3>{s.title}</h3>
          <p class="service-desc">{s.description}</p>
          <ul>
            {s.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===================== PROJECTS ===================== -->
<section id="projects">
  <div class="container">
    <div class="sec-label" data-reveal><span class="sec-num">03</span><span>{t.projects.heading.toLowerCase()}</span></div>
    <div class="section-head" data-reveal>
      <h2>{t.projects.lead}</h2>
    </div>
    <div class="projects-list">
      {t.projects.items.map((p, i) => (
        <a class="proj-row" href={p.href} target="_blank" rel="noopener" data-reveal>
          <span class="proj-index">{pad(i)}</span>
          <div class="proj-main">
            <div class="proj-title">
              <span class="proj-name">{p.name}</span>
              <span class="proj-tagline">{p.tagline}</span>
            </div>
            <p class="proj-desc">{p.description}</p>
            <div class="tags">
              {p.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          <span class="proj-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="projects-all" data-reveal>
      <a class="btn btn-ghost" href={t.projects.allHref} target="_blank" rel="noopener">{t.projects.allLabel} →</a>
    </div>
  </div>
</section>

<!-- ===================== CONTACT ===================== -->
<section id="contact" class="contact-section">
  <div class="container">
    <div class="sec-label" data-reveal><span class="sec-num">04</span><span>{t.nav.contact.toLowerCase()}</span></div>
    <div class="contact-panel" data-reveal>
      <h2>{t.contact.heading}</h2>
      <p class="contact-lead">{t.contact.lead}</p>
      <a class="contact-email" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
      <div class="contact-actions">
        <a class="btn btn-primary" href={`mailto:${t.contact.email}`}>{t.contact.cta} →</a>
        <a class="btn btn-ghost" href={social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href={social.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .hero {
    padding-block: clamp(72px, 12vw, 130px) clamp(48px, 7vw, 84px);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, var(--paper) 96%);
    pointer-events: none;
  }
  .hero .container { position: relative; z-index: 1; }
  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--accent-ink);
    margin-bottom: 22px;
  }
  .hero h1 { font-size: clamp(2.4rem, 6.4vw, 4.2rem); max-width: 900px; }
  .accent-mark {
    font-style: italic;
    font-weight: 600;
    box-shadow: inset 0 -0.18em 0 0 var(--accent-soft), inset 0 -0.22em 0 0 transparent;
    border-bottom: 3px solid var(--accent);
  }
  .hero-sub { color: var(--ink-soft); font-size: clamp(1.02rem, 2vw, 1.2rem); margin-top: 26px; max-width: 640px; }

  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 34px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .pipe-step {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 7px 14px;
    border-radius: var(--radius);
    box-shadow: 3px 3px 0 0 var(--line-strong);
  }
  .pipe-step:last-child { background: var(--ink); color: var(--paper); box-shadow: 3px 3px 0 0 var(--accent); }
  .pipe-arrow { color: var(--accent-ink); font-weight: 600; }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 60px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }
  .stat { padding: 18px 20px; border-right: 1px solid var(--line-strong); display: flex; flex-direction: column; gap: 4px; }
  .stat:last-child { border-right: none; }
  .stat-val { font-family: var(--font-mono); font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 600; color: var(--accent-ink); }
  .stat-label { color: var(--ink-dim); font-size: 0.8rem; line-height: 1.4; }

  /* ABOUT */
  .about-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  .about-text p { color: var(--ink-soft); font-size: 1.06rem; margin-bottom: 18px; }
  .edge-note { border: 1px solid var(--ink); border-radius: var(--radius); padding: 24px; background: var(--paper); box-shadow: 4px 4px 0 0 var(--line-strong); }
  .edge-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--accent);
    padding: 3px 9px;
    margin-bottom: 14px;
  }
  .edge-note p { color: var(--ink-soft); font-size: 0.98rem; }

  .timeline { margin-top: 56px; border-top: 1px solid var(--line); padding-top: 26px; }
  .timeline-heading {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-dim);
  }
  .timeline ol { list-style: none; margin-top: 18px; display: flex; flex-direction: column; }
  .timeline li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 18px;
    padding-block: 10px;
    border-bottom: 1px dashed var(--line);
  }
  .timeline li:last-child { border-bottom: none; }
  .tl-year { font-family: var(--font-mono); font-weight: 600; color: var(--accent-ink); font-size: 0.9rem; padding-top: 2px; }
  .tl-text { color: var(--ink-soft); font-size: 0.98rem; }

  /* SERVICES */
  .services-section { background: var(--paper-soft); border-block: 1px solid var(--line); }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--line-strong); background: var(--paper); }
  .service { padding: 28px 26px; border-right: 1px solid var(--line-strong); display: flex; flex-direction: column; }
  .service:last-child { border-right: none; }
  .service-slug { font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600; color: var(--accent-ink); }
  .service h3 { margin: 14px 0 10px; font-size: 1.22rem; }
  .service-desc { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 18px; flex: 1; }
  .service ul { list-style: none; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--line); padding-top: 16px; }
  .service li { color: var(--ink-soft); font-size: 0.9rem; padding-left: 18px; position: relative; }
  .service li::before { content: '—'; position: absolute; left: 0; color: var(--accent-ink); }

  /* PROJECTS */
  .projects-list { display: flex; flex-direction: column; border-top: 1px solid var(--line-strong); }
  .proj-row {
    display: grid;
    grid-template-columns: 56px 1fr 40px;
    gap: 16px;
    padding: 26px 6px;
    border-bottom: 1px solid var(--line-strong);
    transition: background 0.15s ease;
    align-items: start;
  }
  .proj-row:hover { background: var(--paper-soft); }
  .proj-index { font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink-dim); padding-top: 5px; }
  .proj-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; }
  .proj-name { font-family: var(--font-mono); font-size: 1.12rem; font-weight: 600; color: var(--ink); }
  .proj-row:hover .proj-name { color: var(--accent-ink); }
  .proj-tagline { font-size: 0.88rem; color: var(--ink-dim); }
  .proj-desc { color: var(--ink-soft); font-size: 0.95rem; margin-top: 8px; max-width: 760px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .proj-arrow { font-family: var(--font-mono); color: var(--ink-dim); padding-top: 5px; transition: transform 0.15s ease, color 0.15s ease; }
  .proj-row:hover .proj-arrow { transform: translate(3px, -3px); color: var(--accent-ink); }
  .projects-all { margin-top: 34px; }

  /* CONTACT */
  .contact-panel {
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 6px 6px 0 0 var(--line-strong);
    padding: clamp(32px, 6vw, 60px);
    max-width: 760px;
  }
  .contact-panel h2 { font-size: clamp(1.5rem, 3.4vw, 2.2rem); max-width: 560px; }
  .contact-lead { color: var(--ink-soft); margin-top: 14px; max-width: 540px; }
  .contact-email {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    font-weight: 600;
    color: var(--accent-ink);
    border-bottom: 2px solid var(--accent);
    margin-top: 24px;
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  @media (max-width: 860px) {
    .hero-stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2n) { border-right: none; }
    .stat:nth-child(-n + 2) { border-bottom: 1px solid var(--line-strong); }
    .about-grid { grid-template-columns: 1fr; }
    .services-grid { grid-template-columns: 1fr; }
    .service { border-right: none; border-bottom: 1px solid var(--line-strong); }
    .service:last-child { border-bottom: none; }
    .proj-row { grid-template-columns: 1fr 32px; }
    .proj-index { display: none; }
    .timeline li { grid-template-columns: 56px 1fr; gap: 12px; }
  }
</style>
